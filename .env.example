# Ollama connection (Phase 0 inference runtime)
OLLAMA_HOST=http://localhost:11434

# Model used for the Phase 0 smoke test (must match an `ollama pull`-ed tag)
MODEL_NAME=llama3:8b

# GuideLLM benchmark target. This is the server's BASE url (no /v1): GuideLLM
# appends /v1/chat/completions itself.
BENCHMARK_TARGET=http://localhost:11434

# HuggingFace tokenizer repo id used to count tokens for the benchmark.
# Ollama's model tag (e.g. "llama3:8b") is not a valid HF repo id, so this has
# to be set explicitly to a tokenizer matching the model family.
TOKENIZER_MODEL=NousResearch/Meta-Llama-3-8B

# Number of requests to run in the Phase 0 smoke test
BENCHMARK_REQUEST_COUNT=10

# Embedding model (Test 3, RAG) and the OpenAI-compatible server serving it.
# Defaults to OLLAMA_HOST when EMBEDDING_HOST is unset - set it explicitly
# when generation and embeddings run on different servers (e.g. vLLM for
# generation, Ollama for embeddings - vLLM typically serves one model per
# process, see README.md Sec. 7).
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_HOST=

# Test 3 (RAG) corpus to load and the Qdrant collection to load it into.
# Defaults to the Kubernetes docs sample - override to load something else
# (a .jsonl of pre-chunked passages, or a directory of .txt/.md files - see
# scripts/load_rag_documents.sh).
RAG_CORPUS_FILE=datasets/k8s_rag/corpus_sample.jsonl
RAG_COLLECTION=k8s_docs

# Fixed number of concurrent streams (simultaneous in-flight requests).
# Set to 2 for the first concurrency test on Mac. Avoids GuideLLM's "sweep"
# profile, whose auto-derived concurrency levels failed on this slow local
# hardware (see PROJECT_PLAN.md §9).
BENCHMARK_CONCURRENCY=2

# How many requests Ollama will actually process in parallel (continuous
# batching) instead of serializing them one at a time. Ollama's default is
# effectively 1 on most local setups, which is why Test 2's 4th user waited
# for the other 3 to fully finish. Changing this requires restarting Ollama
# (scripts/start_inference_ollama.sh handles that automatically).
OLLAMA_NUM_PARALLEL=2

# ---------------------------------------------------------------------------
# vLLM (real Brain hardware only - see scripts/start_inference_vllm.sh).
# UNTESTED: written without access to an NVIDIA GPU. Verify flags against
# `vllm serve --help` on the actual machine before relying on this.
# ---------------------------------------------------------------------------

# Hugging Face repo id (NOT an Ollama tag) of the model to serve, e.g.
# meta-llama/Llama-3.1-8B-Instruct. Required by start_inference_vllm.sh.
VLLM_MODEL=

# Set to the number of GPUs to split one model across (multi-GPU tensor parallelism).
VLLM_TENSOR_PARALLEL_SIZE=1

# Fraction of GPU VRAM vLLM is allowed to reserve.
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Optional: context window override, dtype (bfloat16/float16/auto), quantization
# (awq/gptq/fp8 - only if the checkpoint supports it), and any extra vllm serve flags.
VLLM_MAX_MODEL_LEN=
VLLM_MAX_NUM_SEQS=
VLLM_DTYPE=
VLLM_QUANTIZATION=
VLLM_EXTRA_ARGS=

# Needed to download gated models (e.g. Llama) from Hugging Face.
HF_TOKEN=
